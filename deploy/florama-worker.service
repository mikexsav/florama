[Unit]
Description=Florama satellite and ML worker
After=network-online.target
Wants=network-online.target

[Service]
User=florama
Group=florama
WorkingDirectory=/opt/florama/backend
EnvironmentFile=/etc/florama.env
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
ExecStart=/opt/florama/venv-v2/bin/python worker.py
Restart=always
RestartSec=5
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/florama/data
MemoryMax=3G

[Install]
WantedBy=multi-user.target
